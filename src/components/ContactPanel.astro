---
import { profile } from '../data/portfolio';
---

<section class="contact section-shell" id="contact" aria-labelledby="contact-title">
  <div class="contact-paper">
    <div>
      <p class="paper-label">Contact</p>
      <h2 id="contact-title">Shall we build<br />something that moves?</h2>
      <p class="contact-copy">Get in touch to talk about projects, collaboration or engineering challenges.</p>
    </div>
    <div class="contact-links">
      <a class="email-link" href={`mailto:${profile.email}`}>{profile.email}<span aria-hidden="true">↗</span></a>
      <a class="github-link" href={profile.github} target="_blank" rel="noreferrer">GitHub<span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: 55px clamp(75px, 10vw, 125px);
  }

  .contact-paper {
    position: relative;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 34px;
    padding: clamp(30px, 5vw, 65px);
    color: var(--ink);
    background: var(--paper);
    clip-path: polygon(1% 3%, 15% 1%, 32% 3%, 50% 0, 68% 3%, 85% 1%, 99% 4%, 97% 20%, 100% 38%, 97% 56%, 99% 77%, 96% 97%, 78% 95%, 61% 100%, 44% 96%, 25% 99%, 3% 96%, 4% 77%, 0 58%, 3% 39%, 1% 20%);
    transform: rotate(.55deg);
  }

  .contact h2 {
    margin: 13px 0 12px;
    font-family: var(--display);
    font-size: clamp(39px, 6vw, 76px);
    letter-spacing: -.065em;
    line-height: .91;
  }

  .contact-copy {
    max-width: 430px;
    margin: 0;
    color: var(--muted-ink);
    font-size: 15px;
  }

  .contact-links {
    display: grid;
    gap: 10px;
    flex: 0 0 auto;
  }

  .contact-links a {
    min-width: 220px;
    min-height: 47px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 14px;
    font: 12px var(--mono);
  }

  .email-link {
    color: white;
    background: var(--signal);
  }

  .github-link {
    border: 1px solid #77715b;
    color: var(--ink);
  }

  .contact-links a:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 720px) {
    .contact-paper {
      align-items: start;
      flex-direction: column;
    }

    .contact-links {
      width: 100%;
      grid-template-columns: 1fr 1fr;
    }

    .contact-links a {
      min-width: 0;
    }
  }

  @media (max-width: 520px) {
    .contact-paper {
      padding: 30px 25px 34px;
    }

    .contact h2 {
      font-size: 43px;
    }

    .contact-links {
      grid-template-columns: 1fr;
    }
  }
</style>
