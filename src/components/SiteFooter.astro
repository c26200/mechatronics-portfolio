---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <span>CG / Mechatronics</span>
    <span>An independent space for hardware work.</span>
    <span>© {year}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgb(244 239 217 / 32%);
  }

  .footer-inner {
    width: min(100% - 2 * var(--page-gutter), 1440px);
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-inline: auto;
    color: #dbe9d8;
    font: 11px var(--mono);
  }

  @media (max-width: 650px) {
    .footer-inner {
      min-height: 76px;
      flex-wrap: wrap;
      justify-content: space-between;
      padding-block: 16px;
    }

    .footer-inner span:nth-child(2) {
      order: 3;
      width: 100%;
    }
  }
</style>
