<section class="workbench" id="home" data-drag-surface aria-labelledby="hero-title">
  <div class="bench-meta" aria-hidden="true">
    <span>WORKBENCH / CG—01</span>
    <span>MECHATRONICS</span>
  </div>

  <button
    class="loose-object note note-ideas"
    type="button"
    data-draggable
    data-drag-key="idea-note"
    aria-label="Movable note: ideas to systems"
    aria-describedby="drag-instructions"
  >
    <strong>IDEAS → SYSTEMS</strong>
    <span>mechanics</span>
    <span>electronics</span>
    <span>control</span>
  </button>

  <button
    class="loose-object gear-object"
    type="button"
    data-draggable
    data-drag-key="gear"
    aria-label="Movable gear"
    aria-describedby="drag-instructions"
  >
    <svg viewBox="0 0 100 100" fill="none" aria-hidden="true">
      <circle cx="50" cy="50" r="33" />
      <circle cx="50" cy="50" r="11" />
      <path d="M50 5v14m0 62v14M5 50h14m62 0h14M18 18l10 10m44 44 10 10m0-64L72 28M28 72 18 82" />
    </svg>
  </button>

  <button
    class="loose-object note note-process"
    type="button"
    data-draggable
    data-drag-key="process-note"
    aria-label="Movable note: observe, design, test"
    aria-describedby="drag-instructions"
  >
    <strong>IN PROGRESS</strong>
    <span>observe</span>
    <span>design</span>
    <span>test</span>
  </button>

  <div class="loose-object ruler-object" data-draggable data-drag-key="ruler" tabindex="0" role="img" aria-label="Movable illustrated ruler" aria-describedby="drag-instructions">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>

  <div class="loose-object sketch-note" data-draggable data-drag-key="sketch" tabindex="0" role="img" aria-label="Movable geometric sketch" aria-describedby="drag-instructions">
    <svg viewBox="0 0 120 90" fill="none" aria-hidden="true">
      <circle cx="38" cy="42" r="22" />
      <circle cx="38" cy="42" r="6" />
      <path d="M60 42h40m-14-14 14 14-14 14M15 76h90M28 14l21 58" />
      <path d="M78 15h25M90 4v22" stroke-dasharray="3 5" />
    </svg>
  </div>

  <span class="tape-mark" aria-hidden="true"></span>

  <article class="hero-paper">
    <p class="paper-label">Mechatronics portfolio</p>
    <h1 id="hero-title">I shape ideas.<br /><span>I build<br />systems.</span></h1>
    <p class="hero-copy">
      A space to show how ideas connect mechanisms, electronics and control in systems that move.
    </p>
    <div class="hero-actions">
      <a class="primary-action" href="#projects">View projects <span aria-hidden="true">↘</span></a>
      <a class="text-action" href="#areas">Explore areas</a>
    </div>
  </article>

  <div class="bench-footer">
    <p id="drag-instructions">Drag with a mouse or touch; use arrow keys to fine-tune.</p>
    <div class="bench-controls">
      <button type="button" data-reset-layout>Reset layout</button>
      <button type="button" data-toggle-help aria-expanded="false" aria-controls="drag-help">Move items</button>
    </div>
  </div>
  <p class="drag-help" id="drag-help" hidden>Drag objects to rearrange them. Focus an item and use the arrow keys to move it precisely.</p>
</section>

<script>
  const storageKey = 'carlos-mechatronics-workbench-v1';
  const draggables = [...document.querySelectorAll<HTMLElement>('[data-draggable]')];
  type StoredPosition = { x: number; y: number };
  let layout: Record<string, StoredPosition> = {};

  try {
    layout = JSON.parse(localStorage.getItem(storageKey) || '{}') as Record<string, StoredPosition>;
  } catch {
    layout = {};
  }

  const surfaceFor = (item: HTMLElement): HTMLElement | null => item.closest<HTMLElement>('[data-drag-surface]');
  const offsetFor = (item: HTMLElement): StoredPosition => ({
    x: Number.parseFloat(item.style.getPropertyValue('--drag-x')) || 0,
    y: Number.parseFloat(item.style.getPropertyValue('--drag-y')) || 0,
  });

  function applySavedPosition(item: HTMLElement) {
    const key = item.dataset.dragKey;
    if (!key) return;
    const saved = layout[key];
    const surface = surfaceFor(item);
    if (!saved || !surface) return;
    item.style.setProperty('--drag-x', `${saved.x * surface.clientWidth / 100}px`);
    item.style.setProperty('--drag-y', `${saved.y * surface.clientHeight / 100}px`);
  }

  function persistPosition(item: HTMLElement, x: number, y: number) {
    const surface = surfaceFor(item);
    const key = item.dataset.dragKey;
    if (!surface || !key) return;
    layout[key] = {
      x: x / surface.clientWidth * 100,
      y: y / surface.clientHeight * 100,
    };
    try {
      localStorage.setItem(storageKey, JSON.stringify(layout));
    } catch {
      // The workbench remains usable if the browser cannot save preferences.
    }
  }

  function moveBy(item: HTMLElement, x: number, y: number) {
    const surface = surfaceFor(item);
    if (!surface) return;
    const baseX = item.offsetLeft;
    const baseY = item.offsetTop;
    const maxX = Math.max(-baseX, surface.clientWidth - item.offsetWidth - baseX);
    const maxY = Math.max(-baseY, surface.clientHeight - item.offsetHeight - baseY);
    const nextX = Math.min(maxX, Math.max(-baseX, x));
    const nextY = Math.min(maxY, Math.max(-baseY, y));
    item.style.setProperty('--drag-x', `${nextX}px`);
    item.style.setProperty('--drag-y', `${nextY}px`);
    persistPosition(item, nextX, nextY);
  }

  draggables.forEach((item) => {
    applySavedPosition(item);
    let dragStart: (StoredPosition & { pointerX: number; pointerY: number }) | null = null;

    item.addEventListener('pointerdown', (event) => {
      if (event.button !== undefined && event.button !== 0) return;
      const current = offsetFor(item);
      dragStart = { pointerX: event.clientX, pointerY: event.clientY, ...current };
      item.classList.add('is-dragging');
      item.setPointerCapture(event.pointerId);
      event.preventDefault();
    });

    item.addEventListener('pointermove', (event) => {
      if (!dragStart) return;
      moveBy(
        item,
        dragStart.x + event.clientX - dragStart.pointerX,
        dragStart.y + event.clientY - dragStart.pointerY,
      );
    });

    const finishDrag = () => {
      dragStart = null;
      item.classList.remove('is-dragging');
    };

    item.addEventListener('pointerup', finishDrag);
    item.addEventListener('pointercancel', finishDrag);
    item.addEventListener('lostpointercapture', finishDrag);

    item.addEventListener('keydown', (event) => {
      const steps: Partial<Record<KeyboardEvent['key'], [number, number]>> = {
        ArrowLeft: [-12, 0],
        ArrowRight: [12, 0],
        ArrowUp: [0, -12],
        ArrowDown: [0, 12],
      };
      const step = steps[event.key];
      if (!step) return;
      event.preventDefault();
      const current = offsetFor(item);
      moveBy(item, current.x + step[0], current.y + step[1]);
    });
  });

  window.addEventListener('resize', () => draggables.forEach(applySavedPosition));

  document.querySelector('[data-reset-layout]')?.addEventListener('click', () => {
    try {
      localStorage.removeItem(storageKey);
    } catch {
      // Persistence is not required to restore the default layout.
    }
    location.reload();
  });

  const helpButton = document.querySelector<HTMLButtonElement>('[data-toggle-help]');
  const helpMessage = document.querySelector<HTMLElement>('#drag-help');
  helpButton?.addEventListener('click', () => {
    if (!helpMessage) return;
    const isOpen = helpButton.getAttribute('aria-expanded') === 'true';
    helpButton.setAttribute('aria-expanded', String(!isOpen));
    helpMessage.hidden = isOpen;
  });
</script>

